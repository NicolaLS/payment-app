#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/../.."

# shellcheck source=_reglab-common
source e2e/bin/_reglab-common

if command -v docker >/dev/null 2>&1 && docker info >/dev/null 2>&1; then
  slot_containers="$(docker ps -aq \
    --filter label=reglab.managed=true \
    --filter name=reglab_slt_ || true)"
  slot_networks="$(docker network ls -q \
    --filter label=reglab.managed=true \
    --filter name=reglab_slt_ || true)"
else
  slot_containers=""
  slot_networks=""
fi

run_reglab_cli local down || {
  status=$?
  echo "Failed to stop local ReGLab compose stack." >&2
  exit "$status"
}

if [[ -n "$slot_containers" ]]; then
  docker rm -f $slot_containers >/dev/null
fi

if [[ -n "$slot_networks" ]]; then
  docker network rm $slot_networks >/dev/null 2>&1 || true
fi

echo "Stopped local ReGLab."
if [[ -n "$slot_containers" ]]; then
  echo "Removed local ReGLab slot runtime containers."
fi
