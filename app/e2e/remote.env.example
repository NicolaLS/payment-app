# Copy to e2e/.remote.env and fill in the token for trusted remote ReGLab.
export REGLAB_URL=https://reglab.nicolasusca.com
export REGLAB_RUNNER_TOKEN=replace-with-runner-token

# Optional. Defaults are shown here for clarity.
export REGLAB_TEMPLATE=payments-basic
export REGLAB_SNAPSHOT=default
export REGLAB_LEASE_TTL_SECONDS=900
export REGLAB_LEASE_CLAIM_TIMEOUT_SEC=180
