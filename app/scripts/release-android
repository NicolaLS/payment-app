#!/usr/bin/env bash
set -euo pipefail

usage() {
    cat <<'EOF'
Usage: scripts/release-android <version> [--commit COMMIT] [--notes-file PATH] [--draft] [--skip-checks] [--dry-run]

Examples:
  scripts/release-android 2
  scripts/release-android 2 --commit 1b5a9f5 --skip-checks
  scripts/release-android v2 --draft --notes-file /tmp/release-notes.md

This builds the signed Play bundle and universal APK, creates a signed git tag,
pushes the tag, and creates a GitHub release with both artifacts attached.

When --commit points at a commit other than HEAD, the script tags that commit
and uses existing release artifacts instead of building the current working tree.
EOF
}

die() {
    echo "release-android: $*" >&2
    exit 1
}

app_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
version_arg=""
commit_arg=""
notes_file=""
draft=false
skip_checks=false
dry_run=false

while [[ $# -gt 0 ]]; do
    case "$1" in
        --commit)
            [[ $# -ge 2 ]] || die "--commit requires a commit"
            commit_arg="$2"
            shift 2
            ;;
        --notes-file)
            [[ $# -ge 2 ]] || die "--notes-file requires a path"
            notes_file="$2"
            shift 2
            ;;
        --draft)
            draft=true
            shift
            ;;
        --skip-checks)
            skip_checks=true
            shift
            ;;
        --dry-run)
            dry_run=true
            shift
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        -*)
            die "unknown option: $1"
            ;;
        *)
            [[ -z "$version_arg" ]] || die "version was provided more than once"
            version_arg="$1"
            shift
            ;;
    esac
done

[[ -n "$version_arg" ]] || {
    usage
    exit 64
}

tag="v${version_arg#v}"
version="${tag#v}"
release_title="Lasr $tag"
target_ref="${commit_arg:-HEAD}"
target_commit="$(git -C "$app_dir" rev-parse --verify "${target_ref}^{commit}")" ||
    die "commit not found: $target_ref"
current_head="$(git -C "$app_dir" rev-parse --verify HEAD)"
git_prefix="$(git -C "$app_dir" rev-parse --show-prefix)"
gradle_build_file="${git_prefix}androidApp/build.gradle.kts"

if [[ -n "$commit_arg" ]]; then
    gradle_build_contents="$(
        git -C "$app_dir" show "$target_commit:$gradle_build_file"
    )" || die "could not read $gradle_build_file from $target_commit"
    gradle_version="$(
        printf '%s\n' "$gradle_build_contents" |
            sed -nE 's/^[[:space:]]*versionName = "([^"]+)".*/\1/p' |
            head -n 1
    )"
else
    gradle_version="$(
        sed -nE 's/^[[:space:]]*versionName = "([^"]+)".*/\1/p' \
            "$app_dir/androidApp/build.gradle.kts" |
            head -n 1
    )"
fi

[[ -n "$gradle_version" ]] || die "could not read versionName from androidApp/build.gradle.kts"
[[ "$gradle_version" == "$version" ]] ||
    die "versionName is $gradle_version, but requested release tag is $tag"

aab="$app_dir/androidApp/build/outputs/bundle/release/androidApp-release.aab"
apk="$app_dir/androidApp/build/outputs/apk/universal/release/androidApp-release-universal.apk"
use_existing_artifacts=false

if [[ "$target_commit" != "$current_head" ]]; then
    [[ "$skip_checks" == true ]] ||
        die "--commit does not point at HEAD; pass --skip-checks to use existing artifacts"
    use_existing_artifacts=true
fi

gradle_tasks=(":androidApp:printReleaseSigningConfig")
if [[ "$skip_checks" == false ]]; then
    gradle_tasks+=("check")
fi
gradle_tasks+=(":androidApp:buildGithubReleaseArtifacts")

release_args=("--title" "$release_title" "--verify-tag")
if [[ -n "$notes_file" ]]; then
    [[ -f "$notes_file" ]] || die "notes file not found: $notes_file"
    release_args+=("--notes-file" "$notes_file")
else
    release_args+=("--generate-notes")
fi
if [[ "$draft" == true ]]; then
    release_args+=("--draft")
fi

if [[ "$dry_run" == true ]]; then
    echo "Release: $release_title"
    echo "Version: $version"
    echo "Target commit: $target_commit"
    if [[ "$use_existing_artifacts" == true ]]; then
        echo "Gradle: skipped; using existing artifacts"
    else
        echo "Gradle: ./gradlew --no-configuration-cache ${gradle_tasks[*]}"
    fi
    echo "Tag: git tag -s $tag $target_commit -m 'Release $tag'"
    echo "Push: git push origin $tag"
    echo "GitHub: gh release create $tag $aab $apk ${release_args[*]}"
    exit 0
fi

if ! git -C "$app_dir" ls-remote --exit-code origin HEAD >/dev/null 2>&1; then
    die "cannot reach origin with git. Fix SSH auth or run: gh auth setup-git && git remote set-url origin https://github.com/NicolaLS/lasr.git"
fi

branch="$(git -C "$app_dir" branch --show-current)"
[[ "$branch" == "main" ]] || die "release from main; current branch is $branch"

if [[ "$use_existing_artifacts" == false ]]; then
    status="$(git -C "$app_dir" status --porcelain --untracked-files=all)"
    [[ -z "$status" ]] || die "working tree is not clean"
fi

git -C "$app_dir" rev-parse --verify --quiet "refs/tags/$tag" >/dev/null &&
    die "local tag already exists: $tag"

if git -C "$app_dir" ls-remote --exit-code --tags origin "refs/tags/$tag" >/dev/null 2>&1; then
    die "remote tag already exists: $tag"
fi

command -v gh >/dev/null || die "GitHub CLI is required: gh"
command -v bundletool >/dev/null || die "bundletool is required for the universal APK"

gh auth status >/dev/null

if [[ "$use_existing_artifacts" == false ]]; then
    (
        cd "$app_dir"
        ./gradlew --no-configuration-cache "${gradle_tasks[@]}"
    )
fi

[[ -f "$aab" ]] || die "missing release bundle: $aab"
[[ -f "$apk" ]] || die "missing universal APK: $apk"

git -C "$app_dir" tag -s "$tag" "$target_commit" -m "Release $tag"
git -C "$app_dir" push origin "$tag"

(
    cd "$app_dir"
    gh release create "$tag" "$aab" "$apk" "${release_args[@]}"
)

release_url="$(gh release view "$tag" --json url --jq .url)"

echo "Created GitHub release $tag with:"
echo "  $aab"
echo "  $apk"
echo "Release URL: $release_url"
