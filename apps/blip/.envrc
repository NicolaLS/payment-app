export BLIP_RELEASE_BUNDLE_STORE_FILE="/Users/sus/scratch/android-release-blip/publish-key/blip-publish.jks"
export BLIP_RELEASE_BUNDLE_KEY_ALIAS="blip-publish-key"

export BLIP_RELEASE_APK_STORE_FILE="/Users/sus/scratch/android-release-blip/release-key/blip-signing.jks"
export BLIP_RELEASE_APK_KEY_ALIAS="blip-signing-key"

if ! command -v pass >/dev/null 2>&1; then
    echo "pass is required for Android release signing env vars" >&2
    return 0
fi

blip_signing_password="$(pass show blip-signing 2>/dev/null | sed -n '1p')"

if [ -z "$blip_signing_password" ]; then
    echo "pass entry blip-signing is required for Android release signing env vars" >&2
    return 0
fi

export BLIP_RELEASE_BUNDLE_STORE_PASSWORD="$blip_signing_password"
export BLIP_RELEASE_BUNDLE_KEY_PASSWORD="$blip_signing_password"
export BLIP_RELEASE_APK_STORE_PASSWORD="$blip_signing_password"
export BLIP_RELEASE_APK_KEY_PASSWORD="$blip_signing_password"

unset blip_signing_password
