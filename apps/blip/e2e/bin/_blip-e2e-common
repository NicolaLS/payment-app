#!/usr/bin/env bash

APP_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
E2E_DIR="${APP_ROOT}/e2e"
COMPOSE_FILE="${E2E_DIR}/docker-compose.yml"

BLIP_E2E_PROJECT="${BLIP_E2E_PROJECT:-blip-e2e}"
BLIP_E2E_BIND_HOST="${BLIP_E2E_BIND_HOST:-127.0.0.1}"
BLIP_E2E_RELAY_PORT="${BLIP_E2E_RELAY_PORT:-8081}"
BLIP_E2E_HELPER_PORT="${BLIP_E2E_HELPER_PORT:-8082}"
BLIP_E2E_PUBLIC_RELAY_URL="${BLIP_E2E_PUBLIC_RELAY_URL:-ws://127.0.0.1:${BLIP_E2E_RELAY_PORT}}"
BLIP_E2E_ANDROID_RELAY_URL="${BLIP_E2E_ANDROID_RELAY_URL:-ws://10.0.2.2:${BLIP_E2E_RELAY_PORT}}"
BLIP_E2E_IOS_RELAY_URL="${BLIP_E2E_IOS_RELAY_URL:-ws://127.0.0.1:${BLIP_E2E_RELAY_PORT}}"
TEST_WALLET_SERVICE_URL="${TEST_WALLET_SERVICE_URL:-http://127.0.0.1:${BLIP_E2E_HELPER_PORT}}"

export BLIP_E2E_PROJECT
export BLIP_E2E_BIND_HOST
export BLIP_E2E_RELAY_PORT
export BLIP_E2E_HELPER_PORT
export BLIP_E2E_PUBLIC_RELAY_URL

require_command() {
  local name="$1"
  if ! command -v "$name" >/dev/null 2>&1; then
    echo "$name is required" >&2
    exit 127
  fi
}

compose() {
  docker compose -p "$BLIP_E2E_PROJECT" -f "$COMPOSE_FILE" "$@"
}

write_export() {
  local name="$1"
  local value="$2"
  printf 'export %s=%q\n' "$name" "$value"
}

write_e2e_env() {
  local env_file="${E2E_ENV_FILE:-${E2E_DIR}/.env.local}"
  local tmp
  tmp="$(mktemp "${env_file}.tmp.XXXXXX")"
  {
    printf '# Generated by e2e/bin/up. Do not edit or commit.\n'
    write_export BLIP_E2E_PROJECT "$BLIP_E2E_PROJECT"
    write_export BLIP_E2E_RELAY_PORT "$BLIP_E2E_RELAY_PORT"
    write_export BLIP_E2E_HELPER_PORT "$BLIP_E2E_HELPER_PORT"
    write_export TEST_WALLET_SERVICE_URL "$TEST_WALLET_SERVICE_URL"
    write_export TEST_NWC_RELAY_URL "$BLIP_E2E_PUBLIC_RELAY_URL"
    write_export TEST_NWC_RELAY_ANDROID_URL "$BLIP_E2E_ANDROID_RELAY_URL"
    write_export TEST_NWC_RELAY_IOS_URL "$BLIP_E2E_IOS_RELAY_URL"
    if [[ -n "${TEST_NWC_RELAY_DEVICE_URL:-}" ]]; then
      write_export TEST_NWC_RELAY_DEVICE_URL "$TEST_NWC_RELAY_DEVICE_URL"
    fi
  } >"$tmp"
  mv "$tmp" "$env_file"
}

load_e2e_env() {
  local env_file="${E2E_ENV_FILE:-${E2E_DIR}/.env.local}"
  if [[ -f "$env_file" ]]; then
    set -a
    # shellcheck disable=SC1090
    source "$env_file"
    set +a
  fi
}

export_maestro_env() {
  export TEST_WALLET_SERVICE_URL="${TEST_WALLET_SERVICE_URL:-http://127.0.0.1:${BLIP_E2E_HELPER_PORT}}"
  export TEST_NWC_RELAY_URL="${TEST_NWC_RELAY_URL:-$BLIP_E2E_PUBLIC_RELAY_URL}"
  export TEST_NWC_RELAY_ANDROID_URL="${TEST_NWC_RELAY_ANDROID_URL:-$BLIP_E2E_ANDROID_RELAY_URL}"
  export TEST_NWC_RELAY_IOS_URL="${TEST_NWC_RELAY_IOS_URL:-$BLIP_E2E_IOS_RELAY_URL}"
}

helper_url() {
  printf '%s\n' "${TEST_WALLET_SERVICE_URL:-http://127.0.0.1:${BLIP_E2E_HELPER_PORT}}"
}
