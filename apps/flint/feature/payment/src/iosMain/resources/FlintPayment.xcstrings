      }
    },
    "error_payment_unconfirmed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Payment status unknown. It may have succeeded."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zahlungsstatus unbekannt. Die Zahlung ist möglicherweise erfolgt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estado de pago desconocido. Es posible que el pago haya sido exitoso."
          }
        }
      }
    },
