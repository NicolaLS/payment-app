{
  "sourceLanguage": "en",
  "strings": {
    "error_missing_wallet_connection": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect a wallet to continue."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbinde zuerst eine Wallet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecta una billetera para continuar."
          }
        }
      }
    },
    "error_network_unavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No internet connection. Check your network."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Internetverbindung. Prüfe dein Netzwerk."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin conexión a internet. Verifica tu red."
          }
        }
      }
    },
    "error_payment_rejected_generic": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Payment was rejected."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zahlung wurde abgewiesen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El pago fue rechazado."
          }
        }
      }
    },
    "error_payment_rejected_message": {
      "localizations": {
        "en": {
          "stringUnit": {
