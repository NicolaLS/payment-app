CREATE TABLE payment_attempt (
    attempt_id TEXT NOT NULL PRIMARY KEY,
    invoice_fingerprint TEXT NOT NULL UNIQUE,
    payment_method TEXT NOT NULL CHECK (payment_method IN ('BOLT11', 'SPARK_INVOICE')),
    amount_sats INTEGER NOT NULL CHECK (amount_sats > 0),
    fee_sats INTEGER NOT NULL CHECK (fee_sats >= 0),
    origin TEXT NOT NULL,
    created_at_epoch_seconds INTEGER NOT NULL,
    updated_at_epoch_seconds INTEGER NOT NULL,
    link_phase TEXT NOT NULL CHECK (link_phase IN ('CONFIRMED', 'SUBMISSION_STARTED', 'SDK_PAYMENT_LINKED')),
    breez_payment_id TEXT UNIQUE,
    fiat_currency_code TEXT,
    fiat_currency_name TEXT,
    fiat_fraction_digits INTEGER,
    fiat_amount_minor INTEGER,
    fiat_price_per_bitcoin REAL,
    fiat_rate_observed_at_epoch_seconds INTEGER
);

CREATE INDEX payment_attempt_phase_updated
ON payment_attempt(link_phase, updated_at_epoch_seconds);

insertAttempt:
INSERT INTO payment_attempt(
    attempt_id,
    invoice_fingerprint,
    payment_method,
    amount_sats,
    fee_sats,
    origin,
    created_at_epoch_seconds,
    updated_at_epoch_seconds,
    link_phase,
    breez_payment_id,
    fiat_currency_code,
    fiat_currency_name,
    fiat_fraction_digits,
    fiat_amount_minor,
    fiat_price_per_bitcoin,
    fiat_rate_observed_at_epoch_seconds
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, 'CONFIRMED', NULL, ?, ?, ?, ?, ?, ?);

selectById:
SELECT * FROM payment_attempt WHERE attempt_id = ?;

selectByFingerprint:
SELECT * FROM payment_attempt WHERE invoice_fingerprint = ?;

selectAll:
SELECT * FROM payment_attempt ORDER BY created_at_epoch_seconds ASC, attempt_id ASC;

selectUnresolved:
SELECT * FROM payment_attempt
WHERE link_phase = 'SUBMISSION_STARTED' AND breez_payment_id IS NULL
ORDER BY created_at_epoch_seconds ASC;

selectLinked:
SELECT * FROM payment_attempt
WHERE link_phase = 'SDK_PAYMENT_LINKED' AND breez_payment_id IS NOT NULL
ORDER BY updated_at_epoch_seconds ASC;

markSubmissionStarted:
UPDATE payment_attempt
SET link_phase = 'SUBMISSION_STARTED', updated_at_epoch_seconds = ?
WHERE attempt_id = ? AND link_phase = 'CONFIRMED' AND breez_payment_id IS NULL;

linkPayment:
UPDATE payment_attempt
SET link_phase = 'SDK_PAYMENT_LINKED', breez_payment_id = ?, updated_at_epoch_seconds = ?
WHERE attempt_id = ?
  AND link_phase IN ('SUBMISSION_STARTED', 'SDK_PAYMENT_LINKED')
  AND (breez_payment_id IS NULL OR breez_payment_id = ?);

deleteLinkedBefore:
DELETE FROM payment_attempt
WHERE link_phase = 'SDK_PAYMENT_LINKED' AND updated_at_epoch_seconds < ?;

deleteOldestLinkedOverflow:
DELETE FROM payment_attempt
WHERE attempt_id IN (
    SELECT attempt_id FROM payment_attempt
    WHERE link_phase = 'SDK_PAYMENT_LINKED'
    ORDER BY updated_at_epoch_seconds DESC, attempt_id DESC
    LIMIT -1 OFFSET ?
);

countAll:
SELECT count(*) FROM payment_attempt;

clearAll:
DELETE FROM payment_attempt;
