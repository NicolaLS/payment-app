{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Implemented Payment Hub metric content v1",
  "type": "object",
  "required": [
    "protocolVersion",
    "widgetId",
    "variantId",
    "contract",
    "metric"
  ],
  "properties": {
    "protocolVersion": {
      "const": 1
    },
    "widgetId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "variantId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "contract": {
      "const": "metric/v1"
    },
    "metric": {
      "type": "object",
      "required": [
        "value",
        "unit",
        "label",
        "asOf"
      ],
      "properties": {
        "value": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 24,
          "pattern": "\\S"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "\\S"
        },
        "asOf": {
          "type": "string",
          "format": "date-time"
        },
        "refreshAfterSeconds": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 30,
          "maximum": 86400
        }
      }
    }
  }
}
