{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Future service catalogue example \u2014 unsupported by current clients",
  "$comment": "Design example only. There are no service purchase endpoints or supported native purchase handlers.",
  "type": "object",
  "required": [
    "protocolVersion",
    "widgets"
  ],
  "properties": {
    "protocolVersion": {
      "const": 1
    },
    "widgets": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "required": [
          "id",
          "revision",
          "contract",
          "title",
          "variants"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(?!local\\.)[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "revision": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "\\S"
          },
          "contract": {
            "const": "service/v1"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "\\S"
          },
          "description": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 500
          },
          "variants": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "object",
              "required": [
                "id",
                "title",
                "template"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
                },
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120,
                  "pattern": "\\S"
                },
                "template": {
                  "const": "service-options"
                },
                "size": {
                  "enum": [
                    "small",
                    "wide",
                    "large"
                  ],
                  "default": "small"
                }
              }
            }
          },
          "fields": {
            "type": "array",
            "maxItems": 16,
            "items": {
              "type": "object",
              "required": [
                "id",
                "label",
                "type"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120,
                  "pattern": "\\S"
                },
                "type": {
                  "enum": [
                    "text",
                    "phone",
                    "choice"
                  ]
                },
                "required": {
                  "type": "boolean",
                  "default": false
                },
                "maxLength": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 1,
                  "maximum": 256
                },
                "options": {
                  "type": "array",
                  "maxItems": 64,
                  "items": {
                    "type": "object",
                    "required": [
                      "id",
                      "label"
                    ],
                    "properties": {
                      "id": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
                      },
                      "label": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 120,
                        "pattern": "\\S"
                      }
                    }
                  }
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "type": {
                        "const": "choice"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "options"
                    ],
                    "properties": {
                      "options": {
                        "minItems": 1
                      }
                    }
                  }
                }
              ]
            }
          },
          "actions": {
            "type": "array",
            "maxItems": 4,
            "items": {
              "type": "object",
              "required": [
                "id",
                "title",
                "kind",
                "purchaseContract"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
                },
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120,
                  "pattern": "\\S"
                },
                "kind": {
                  "const": "purchase"
                },
                "purchaseContract": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              }
            }
          }
        }
      }
    }
  }
}
