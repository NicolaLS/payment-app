{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Implemented native service/v1 catalogue for the Claro experiment",
  "type": "object",
  "required": [
    "protocolVersion",
    "widgets"
  ],
  "properties": {
    "protocolVersion": {
      "const": 1
    },
    "widgets": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "required": [
          "id",
          "revision",
          "contract",
          "title",
          "variants",
          "fields",
          "actions"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(?!local\\.)[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "revision": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "\\S"
          },
          "contract": {
            "const": "service/v1"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "\\S"
          },
          "description": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 500
          },
          "variants": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "object",
              "required": [
                "id",
                "title",
                "template",
                "size"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
                },
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120,
                  "pattern": "\\S"
                },
                "template": {
                  "enum": [
                    "service-topup",
                    "service-packages"
                  ]
                },
                "size": {
                  "enum": [
                    "small",
                    "wide",
                    "large"
                  ]
                }
              },
              "oneOf": [
                {
                  "properties": {
                    "template": {
                      "const": "service-topup"
                    },
                    "size": {
                      "const": "small"
                    }
                  }
                },
                {
                  "properties": {
                    "template": {
                      "const": "service-packages"
                    },
                    "size": {
                      "enum": [
                        "wide",
                        "large"
                      ]
                    }
                  }
                }
              ]
            }
          },
          "fields": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1,
            "items": {
              "type": "object",
              "required": [
                "id",
                "label",
                "type",
                "required",
                "maxLength"
              ],
              "properties": {
                "id": {
                  "const": "phone"
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120,
                  "pattern": "\\S"
                },
                "type": {
                  "const": "phone"
                },
                "required": {
                  "const": true
                },
                "maxLength": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 16
                },
                "options": {
                  "type": "array",
                  "maxItems": 0
                }
              }
            }
          },
          "actions": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1,
            "items": {
              "type": "object",
              "required": [
                "id",
                "title",
                "kind"
              ],
              "properties": {
                "id": {
                  "const": "purchase"
                },
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120,
                  "pattern": "\\S"
                },
                "kind": {
                  "const": "purchase"
                }
              }
            }
          }
        }
      }
    }
  }
}
