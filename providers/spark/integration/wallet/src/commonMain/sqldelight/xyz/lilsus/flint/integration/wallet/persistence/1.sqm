CREATE TABLE payment_attempt (
    attempt_id TEXT NOT NULL PRIMARY KEY,
    invoice_fingerprint TEXT NOT NULL UNIQUE,
    payment_method TEXT NOT NULL CHECK (payment_method IN ('BOLT11', 'SPARK_INVOICE')),
    amount_sats INTEGER NOT NULL CHECK (amount_sats > 0),
    fee_sats INTEGER NOT NULL CHECK (fee_sats >= 0),
    origin TEXT NOT NULL,
    created_at_epoch_seconds INTEGER NOT NULL,
    updated_at_epoch_seconds INTEGER NOT NULL,
    link_phase TEXT NOT NULL CHECK (link_phase IN ('CONFIRMED', 'SUBMISSION_STARTED', 'SDK_PAYMENT_LINKED')),
    breez_payment_id TEXT UNIQUE,
    fiat_currency_code TEXT,
    fiat_currency_name TEXT,
    fiat_fraction_digits INTEGER,
    fiat_amount_minor INTEGER,
    fiat_price_per_bitcoin REAL,
    fiat_rate_observed_at_epoch_seconds INTEGER
);

CREATE INDEX payment_attempt_phase_updated
ON payment_attempt(link_phase, updated_at_epoch_seconds);

CREATE TABLE payment_currency_preference (
    singleton INTEGER NOT NULL PRIMARY KEY CHECK (singleton = 1),
    primary_code TEXT NOT NULL,
    secondary_code TEXT NOT NULL,
    CHECK (length(primary_code) = 3),
    CHECK (length(secondary_code) = 3),
    CHECK (primary_code != secondary_code)
);

INSERT INTO payment_currency_preference(singleton, primary_code, secondary_code)
VALUES (1, 'SAT', 'USD');

CREATE TABLE payment_policy (
    singleton INTEGER NOT NULL PRIMARY KEY CHECK (singleton = 1),
    mode TEXT NOT NULL CHECK (mode IN ('ALWAYS', 'THRESHOLD')),
    amount_threshold_sats INTEGER NOT NULL CHECK (amount_threshold_sats > 0),
    fee_threshold_sats INTEGER NOT NULL CHECK (fee_threshold_sats >= 0)
);

INSERT INTO payment_policy(singleton, mode, amount_threshold_sats, fee_threshold_sats)
VALUES (1, 'ALWAYS', 10000, 0);
