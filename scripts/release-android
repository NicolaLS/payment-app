#!/usr/bin/env bash
set -euo pipefail

usage() {
    echo "Usage: scripts/release-android <blip|flint|lasr> <version> [--skip-checks]" >&2
}

die() {
    echo "release-android: $*" >&2
    exit 1
}

[[ $# -ge 2 ]] || {
    usage
    exit 64
}

app="$1"
version="$2"
shift 2

case "$app" in
    blip|flint|lasr) ;;
    *) die "app must be blip, flint, or lasr" ;;
esac

skip_checks=false
if [[ "${1-}" == "--skip-checks" ]]; then
    skip_checks=true
    shift
fi
[[ $# -eq 0 ]] || die "unknown argument: $1"

repo="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
build_file="$repo/apps/$app/androidApp/build.gradle.kts"
configured_version="$(
    sed -nE 's/^[[:space:]]*versionName = "([^"]+)".*/\1/p' "$build_file" |
        head -n 1
)"
[[ "$configured_version" == "$version" ]] ||
    die "$app versionName is $configured_version, requested $version"

# Both identities are needed: the upload key signs the Play bundle, the
# app-signing key signs the APK distributed through GitHub and Zapstore.
require_identity() {
    local prefix="$1"
    local store_var="${prefix}_STORE_FILE"
    local alias_var="${prefix}_KEY_ALIAS"
    local password_var="${prefix}_STORE_PASSWORD"
    local password_file_var="${prefix}_STORE_PASSWORD_FILE"

    [[ -n "${!store_var-}" ]] || die "$store_var is required"
    [[ -f "${!store_var}" ]] || die "keystore not found: ${!store_var}"
    [[ -n "${!alias_var-}" ]] || die "$alias_var is required"
    [[ -n "${!password_var-}" || -n "${!password_file_var-}" ]] ||
        die "$password_var or $password_file_var is required"
}

require_identity RAYL_UPLOAD
require_identity RAYL_APP_SIGNING

if [[ "$app" == "flint" && -z "${FLINT_BREEZ_API_KEY-}" ]]; then
    die "FLINT_BREEZ_API_KEY is required for a Flint release candidate"
fi

[[ -z "$(git -C "$repo" status --porcelain --untracked-files=all)" ]] ||
    die "working tree must be clean"

tasks=()
if [[ "$skip_checks" == false ]]; then
    tasks+=("ktlintCheck" "check")
fi
tasks+=(":$app:androidApp:buildGithubReleaseArtifacts")

"$repo/gradlew" -p "$repo" "${tasks[@]}"

aab="$repo/apps/$app/androidApp/build/outputs/bundle/release/androidApp-release.aab"
apk="$repo/apps/$app/androidApp/build/outputs/apk/universal/release/$app-release-universal.apk"
[[ -f "$aab" ]] || die "missing bundle: $aab"
[[ -f "$apk" ]] || die "missing universal APK: $apk"

jarsigner -verify -strict "$aab" >/dev/null ||
    die "bundle signature verification failed"

output_dir="$repo/dist/$app"
mkdir -p "$output_dir"
staged_aab="$output_dir/$app-$version-play.aab"
cp "$aab" "$staged_aab"

echo
echo "Staged $staged_aab"
shasum -a 256 "$staged_aab"

# Asserts the pinned app-signing certificate before staging the APK.
"$repo/scripts/verify-release-apk" "$app" "$apk"

echo
echo "Next:"
echo "  1. Upload $staged_aab to Play internal testing."
echo "  2. Attach the staged universal APK to the $app-v$version GitHub release."
echo "  3. Run zsp publish --check for the matching Zapstore config."
echo "  4. Record both SHA-256 values in the release evidence document."
