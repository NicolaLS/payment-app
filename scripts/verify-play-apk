#!/usr/bin/env bash
set -euo pipefail

die() {
    echo "verify-play-apk: $*" >&2
    exit 1
}

[[ $# -eq 2 ]] || die "usage: scripts/verify-play-apk <blip|lasr> <apk>"
app="$1"
apk="$2"

case "$app" in
    blip) expected_package="xyz.lilsus.blip" ;;
    lasr) expected_package="xyz.lilsus.lasr" ;;
    *) die "app must be blip or lasr" ;;
esac

[[ -f "$apk" ]] || die "APK not found: $apk"

apkanalyzer_bin="$(command -v apkanalyzer || true)"
apksigner_bin="$(command -v apksigner || true)"
[[ -n "$apkanalyzer_bin" ]] || die "apkanalyzer is required"
[[ -n "$apksigner_bin" ]] || die "apksigner is required"

actual_package="$("$apkanalyzer_bin" manifest application-id "$apk")"
[[ "$actual_package" == "$expected_package" ]] ||
    die "expected $expected_package, found $actual_package"

"$apksigner_bin" verify --verbose --print-certs "$apk"
version="$("$apkanalyzer_bin" manifest version-name "$apk")"

repo="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
output_dir="$repo/dist/$app"
output="$output_dir/$app-$version-universal.apk"
mkdir -p "$output_dir"
cp "$apk" "$output"

echo "Version: $version"
echo "Verified and copied to $output"
shasum -a 256 "$output"
