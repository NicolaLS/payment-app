#!/usr/bin/env bash
set -euo pipefail

die() {
    echo "verify-release-apk: $*" >&2
    exit 1
}

[[ $# -eq 2 ]] || die "usage: scripts/verify-release-apk <blip|lasr> <apk>"
app="$1"
apk="$2"

case "$app" in
    blip) expected_package="xyz.lilsus.blip" ;;
    lasr) expected_package="xyz.lilsus.lasr" ;;
    *) die "app must be blip or lasr" ;;
esac

[[ -f "$apk" ]] || die "APK not found: $apk"

apkanalyzer_bin="$(command -v apkanalyzer || true)"
apksigner_bin="$(command -v apksigner || true)"
[[ -n "$apkanalyzer_bin" ]] || die "apkanalyzer is required"
[[ -n "$apksigner_bin" ]] || die "apksigner is required"

repo="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
fingerprint_file="$repo/distribution/app-signing-certificate.sha256"
[[ -f "$fingerprint_file" ]] || die "missing fingerprint pin: $fingerprint_file"

expected_fingerprint="$(
    sed -e 's/#.*//' "$fingerprint_file" | tr -d '[:space:]' | tr 'A-F' 'a-f'
)"
[[ -n "$expected_fingerprint" ]] || die "no fingerprint recorded in $fingerprint_file"

actual_package="$("$apkanalyzer_bin" manifest application-id "$apk")"
[[ "$actual_package" == "$expected_package" ]] ||
    die "expected $expected_package, found $actual_package"

"$apksigner_bin" verify --verbose --print-certs "$apk"

actual_fingerprint="$(
    "$apksigner_bin" verify --print-certs "$apk" |
        sed -nE 's/^Signer #1 certificate SHA-256 digest: ([0-9a-fA-F]+)$/\1/p' |
        tr 'A-F' 'a-f'
)"
[[ -n "$actual_fingerprint" ]] || die "could not read the signing certificate fingerprint"

if [[ "$actual_fingerprint" != "$expected_fingerprint" ]]; then
    die "$(
        cat <<EOF
app-signing certificate mismatch. Refusing to stage this APK.

  expected: $expected_fingerprint
  actual:   $actual_fingerprint

Publishing this artifact would break updates for every existing sideload and
Zapstore install. Check RAYL_APP_SIGNING_* before retrying, and only change
$fingerprint_file when the signing identity itself is intentionally replaced.
EOF
    )"
fi

version="$("$apkanalyzer_bin" manifest version-name "$apk")"
output_dir="$repo/dist/$app"
output="$output_dir/$app-$version-universal.apk"
mkdir -p "$output_dir"
cp "$apk" "$output"

echo
echo "App: $app $version"
echo "App-signing certificate matches the recorded suite fingerprint."
echo "Staged $output"
shasum -a 256 "$output"
